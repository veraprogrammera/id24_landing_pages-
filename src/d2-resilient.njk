</script>
<script>
  // ---- Failure pill interactive panel ----
  const FAILURE_DATA = {
    processor: {
      title: 'Payment Processor Outage',
      desc: 'Your payment processor (Adyen, Nets, Stripe…) goes offline. No one can accept card payments regardless of whether your own systems are running.',
      retail: 'Every checkout fails. Staff resort to manual processes or turn customers away entirely.',
      hotels: 'Check-out becomes impossible. Guests are left stranded or trust is permanently lost.',
      banks: 'Card authorizations fail across the network. Fraud exposure increases without real-time monitoring.'
    },
    network: {
      title: 'Network Connectivity Loss',
      desc: 'Internet or private network drops — cloud services, payment APIs, and POS backends all become unreachable simultaneously.',
      retail: 'POS terminals freeze. Staff cannot process payments or even look up product prices.',
      hotels: 'Property management systems go offline. Rooms cannot be assigned, billed, or managed.',
      banks: 'Branch operations halt. ATM networks degrade. Customer service entirely breaks down.'
    },
    cloud: {
      title: 'Cloud Service Downtime',
      desc: 'A cloud provider outage (AWS, Azure, GCP) takes your hosted payment services and backend APIs completely offline.',
      retail: 'Loyalty programs, inventory, and payment APIs stop responding at the same time.',
      hotels: 'Booking confirmation engines and dynamic pricing systems go offline entirely.',
      banks: 'Core banking APIs go dark. Mobile and online banking stops for every customer.'
    },
    pos: {
      title: 'POS System Failure',
      desc: 'Point-of-sale software or hardware crashes — terminals stop accepting input, freeze, or display errors that staff cannot resolve.',
      retail: 'Cashiers cannot complete any transaction. Manual fallback is slow, error-prone, and exposes compliance risk.',
      hotels: 'Front desk cannot register arrivals or process payments for guests on site.',
      banks: 'Branch teller systems fail. Customer wait times spike and SLAs are breached.'
    },
    acquirer: {
      title: 'Acquirer Disruption',
      desc: 'Your acquiring bank or payment gateway goes down — transactions cannot be routed or settled even if everything else is working.',
      retail: 'All card payments are declined even when your network is up and terminals are fully operational.',
      hotels: 'Pre-authorized cards cannot be settled at check-out, causing billing disputes.',
      banks: 'Inter-bank settlement is delayed, affecting cash flow, reporting, and regulatory compliance.'
    }
  };

  function showFailureDetail(key) {
    const data = FAILURE_DATA[key];
    if (!data) return;

    const panel = document.getElementById('failure-detail');

    // Trigger re-animation
    panel.classList.remove('is-animating');
    void panel.offsetWidth; // reflow
    panel.classList.add('is-animating');

    document.getElementById('fd-title').textContent = data.title;
    document.getElementById('fd-desc').textContent = data.desc;
    document.getElementById('fd-retail').textContent = data.retail;
    document.getElementById('fd-hotels').textContent = data.hotels;
    document.getElementById('fd-banks').textContent = data.banks;

    // Update active pill
    document.querySelectorAll('.failure-pill').forEach(p => p.classList.remove('active'));
    const activePill = document.querySelector(`.failure-pill[data-key="${key}"]`);
    if (activePill) activePill.classList.add('active');
  }

  // ---- Matrix Rain ----
  function createMatrixCanvas() {
    const hero = document.querySelector('.hero');
    const canvas = document.createElement('canvas');
    canvas.classList.add('matrix-canvas');
    hero.insertBefore(canvas, hero.firstChild);
    return canvas;
  }

  function startMatrixRain(canvas) {
    const ctx = canvas.getContext('2d');
    const fontSize = 14;
    const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲンD|20123456789';
    let columns, drops;

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      const w = canvas.offsetWidth;
      const h = canvas.offsetHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.scale(dpr, dpr);

      const spacing = window.innerWidth < 768 ? fontSize * 2 : fontSize;
      columns = Math.floor(w / spacing);
      drops = new Array(columns).fill(0).map(() => Math.random() * -50);
    }

    resize();

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 200);
    });

    const darkBlue = 'rgba(27, 58, 92, ';
    const brightBlue = '#5BA4D9';

    const intervalId = setInterval(() => {
      const w = canvas.offsetWidth;
      const h = canvas.offsetHeight;

      // Semi-transparent overlay for trail effect
      ctx.fillStyle = 'rgba(13, 17, 23, 0.12)';
      ctx.fillRect(0, 0, w, h);

      ctx.font = fontSize + 'px monospace';

      const spacing = window.innerWidth < 768 ? fontSize * 2 : fontSize;

      for (let i = 0; i < columns; i++) {
        const char = chars[Math.floor(Math.random() * chars.length)];
        const x = i * spacing;
        const y = drops[i] * fontSize;

        // ~8% chance of bright blue "head" character
        if (Math.random() < 0.08) {
          ctx.fillStyle = brightBlue;
          ctx.shadowColor = brightBlue;
          ctx.shadowBlur = 8;
        } else {
          const alpha = 0.4 + Math.random() * 0.5;
          ctx.fillStyle = darkBlue + alpha + ')';
          ctx.shadowBlur = 0;
        }

        ctx.fillText(char, x, y);
        ctx.shadowBlur = 0;

        // Reset drop when it passes the bottom
        if (y > h && Math.random() > 0.975) {
          drops[i] = 0;
        }
        drops[i]++;
      }
    }, 33);

    // Fade canvas in
    requestAnimationFrame(() => {
      canvas.style.opacity = '0.7';
    });

    return intervalId;
  }

  // Init first pill on load
  document.addEventListener('DOMContentLoaded', () => {
    showFailureDetail('processor');

    document.querySelectorAll('.failure-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        if (!pill.classList.contains('active')) showFailureDetail(pill.dataset.key);
      });
    });

    // ---- Accordion cards (mobile) ----
    if (window.innerWidth <= 768) {
      function setupAccordion(selector) {
        document.querySelectorAll(selector).forEach(card => {
          card.addEventListener('click', () => {
            const wasOpen = card.classList.contains('is-open');
            document.querySelectorAll(selector + '.is-open').forEach(c => c.classList.remove('is-open'));
            if (!wasOpen) card.classList.add('is-open');
          });
        });
      }
      setupAccordion('.principle-card');
      setupAccordion('.why-card');

      // Scenario toggle
      const scenarioSwitch = document.querySelector('.scenario-toggle__switch');
      const scenarioLabels = document.querySelectorAll('.scenario-toggle__label');
      const colBefore = document.querySelector('.scenario-col--before');
      const colAfter = document.querySelector('.scenario-col--after');

      function setScenario(showAfter) {
        scenarioSwitch.classList.toggle('is-on', showAfter);
        colBefore.classList.toggle('is-active', !showAfter);
        colAfter.classList.toggle('is-active', showAfter);
        scenarioLabels.forEach(l => {
          l.classList.toggle('is-active', l.dataset.scenario === (showAfter ? 'after' : 'before'));
        });
      }

      // Default: show "With D|2"
      setScenario(true);

      scenarioSwitch.addEventListener('click', () => {
        setScenario(!scenarioSwitch.classList.contains('is-on'));
      });

      scenarioLabels.forEach(label => {
        label.addEventListener('click', () => {
          setScenario(label.dataset.scenario === 'after');
        });
      });
    }

    // ---- Dark Mode State ----
    const matrixCanvas = createMatrixCanvas();
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let matrixInterval = null;
    let isDark = false;

    function enableDarkMode(withWipe) {
      if (isDark) return;
      isDark = true;

      if (withWipe) {
        document.body.classList.add('dark-wipe');
        document.body.classList.add('dark-mode');
        if (!prefersReducedMotion) {
          matrixInterval = startMatrixRain(matrixCanvas);
        }
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.body.classList.add('dark-wipe-go');
          });
        });
        setTimeout(() => {
          document.body.classList.remove('dark-wipe', 'dark-wipe-go');
        }, 450);
      } else {
        document.body.classList.add('dark-mode');
        if (!prefersReducedMotion) {
          matrixInterval = startMatrixRain(matrixCanvas);
        }
      }
    }

    function disableDarkMode() {
      if (!isDark) return;
      isDark = false;
      document.body.classList.remove('dark-mode');
      if (matrixInterval) {
        clearInterval(matrixInterval);
        matrixInterval = null;
      }
      matrixCanvas.style.opacity = '0';
    }

    // Auto-trigger after 2s
    setTimeout(() => enableDarkMode(true), 2000);

    // Manual toggle
    document.getElementById('theme-toggle').addEventListener('click', () => {
      if (isDark) {
        disableDarkMode();
      } else {
        enableDarkMode(false);
      }
    });
  });

  // ---- Nav scroll shadow ----
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('nav--scrolled', window.scrollY > 20);
  }, { passive: true });

  // ---- Scroll reveal via IntersectionObserver ----
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      entry.target.classList.toggle('revealed', entry.isIntersecting);
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));
</script>
